<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>TRUMPET GARDEN v1.73</title>
    <style>
        :root { --p: #9d00ff; --o: #FF4500; --g: #0f0; --y: #ffcc00; --gry: #888; }
        body { margin: 0; background: #000; color: #fff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
        .fae { filter: invert(1) hue-rotate(180deg); background: #fff !important; }
        #gate { position: fixed; inset: 0; background: #000; z-index: 1000; display: flex; justify-content: center; align-items: center; }
        #ui { position: absolute; inset: 0; z-index: 100; display: none; }
        
        /* HEADER: Performance Sizing */
        #header { width: 100%; height: 90px; background: rgba(10,10,10,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; border-bottom: 2px solid #333; }
        .h-row { display: flex; align-items: center; justify-content: center; gap: 8px; width: 98%; }
        .btn { background: #111; border: 2px solid var(--p); color: #fff; padding: 12px 8px; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 11px; flex: 1; text-align: center; }
        .b-yel { border-color: var(--y); color: var(--y); }
        .b-gry { border-color: var(--gry); color: var(--gry); }
        .b-glitch { border-color: #ff4444; color: #ff4444; }
        .b-save { border-color: #44aaff; color: #44aaff; }
        #diag { font-size: 9px; color: var(--g); margin-top: 5px; text-transform: uppercase; font-weight: bold; }

        /* CONTROLS: Restored Proportions */
        #ctrl { position: absolute; top: 100px; width: 100%; display: flex; justify-content: center; gap: 40px; z-index: 200; }
        .unit { width: 100px; height: 100px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
        .h-btn { width: 85px; height: 85px; border-radius: 50%; background: #111; border: 2px solid #fff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36px; cursor: pointer; z-index: 5; }
        .h-lab { font-size: 10px; font-weight: bold; margin-top: 8px; letter-spacing: 1px; }
        
        /* SIDE SLIDERS */
        .sld { position: absolute; width: 50px; height: 260px; background: #111; border: 2px solid #555; border-radius: 25px; top: 220px; pointer-events: auto; z-index: 300; }
        #l-s { left: 4%; } #r-s { right: 4%; }
        .fill { width: 100%; position: absolute; bottom: 0; background: linear-gradient(to top, var(--o), #fff); border-radius: 25px; pointer-events: none; }
        
        .pad-c { position: absolute; bottom: 80px; width: 100%; display: flex; justify-content: center; gap: 40px; pointer-events: none; }
        #osc { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
    </style>
</head>
<body>
<div id="gate"><button id="b-mic" class="btn" style="font-size: 24px; padding: 25px 50px;">IGNITE v1.73</button></div>
<div id="ui">
    <div id="header">
        <div class="h-row">
            <button id="p-rec-play" class="btn b-yel">PLAY 🐝</button>
            <button id="p-lock" class="btn" onclick="toggleLock()">LOCK: OFF</button>
            <button id="b-save" class="btn b-save">SAVE 💾</button>
            <button id="b-glitch" class="btn b-glitch">GLITCH 💥</button>
            <button id="p-file-play" class="btn b-gry">PLAY 📂</button>
        </div>
        <div id="diag">STATUS: ENGINE SHIELDED</div>
    </div>
    <div id="ctrl">
        <div class="unit"><button id="b-rec" class="h-btn">🐝</button><div class="h-lab">REC</div></div>
        <div class="unit"><button id="b-file" class="h-btn">📂</button><input type="file" id="f-in" hidden accept="*/*"><div class="h-lab">LOAD</div></div>
    </div>
    
    <div id="l-s" class="sld" onpointerdown="slide(event,'l')" onpointermove="slide(event,'l')"><div id="l-f" class="fill" style="height:50%"></div></div>
    <div id="r-s" class="sld" onpointerdown="slide(event,'r')" onpointermove="slide(event,'r')"><div id="r-f" class="fill" style="height:50%"></div></div>

    <div class="pad-c">
        <svg width="220" height="220" style="pointer-events:auto"><circle cx="40" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/></svg>
        <svg width="220" height="220" style="pointer-events:auto"><circle cx="40" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/></svg>
    </div>
</div>
<canvas id="osc"></canvas>
<script>
let aCtx, anal, src, rec, chks = [], recUrl = null, fileUrl = null, isL = false, isF = false, ints = {l:0.5, r:0.5}, isR = false, activeA = null, rawData = null, activeBlob = null;
const cvs = document.getElementById('osc'), ctx = cvs.getContext('2d'), diag = document.getElementById('diag');
const bMic = document.getElementById('b-mic'), bRec = document.getElementById('b-rec'), bFile = document.getElementById('b-file'), fIn = document.getElementById('f-in'), bGlitch = document.getElementById('b-glitch'), bSave = document.getElementById('b-save');

bMic.onclick = async () => {
    document.getElementById('gate').style.display = 'none'; document.getElementById('ui').style.display = 'block';
    try {
        aCtx = new (window.AudioContext || window.webkitAudioContext)();
        const s = await navigator.mediaDevices.getUserMedia({ audio: true });
        src = aCtx.createMediaStreamSource(s); anal = aCtx.createAnalyser(); anal.fftSize = 2048; 
        draw();
    } catch (err) { diag.innerText = "MIC ERROR"; }
};

bRec.onclick = () => {
    if (rec && rec.state === "recording") return;
    chks = []; isR = true; src.connect(anal);
    rec = new MediaRecorder(src.mediaStream);
    rec.ondataavailable = e => chks.push(e.data);
    rec.onstop = async () => {
        activeBlob = new Blob(chks, { type: 'audio/webm' });
        recUrl = URL.createObjectURL(activeBlob);
        const hex = await getHex(activeBlob);
        diag.innerText = `🐝 ${activeBlob.size}B | HEX: ${hex}`;
        src.disconnect(anal); isR = false;
    };
    rec.start();
    setTimeout(() => { if(rec.state==="recording") rec.stop(); }, 3500);
};

async function getHex(blob) {
    const buf = await blob.slice(0, 8).arrayBuffer();
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join(' ');
}

bSave.onclick = () => { if (activeBlob) { const a = document.createElement('a'); a.href = recUrl; a.download = `rec_v173.webm`; a.click(); } };

bFile.onclick = () => fIn.click();
fIn.onchange = async e => {
    const f = e.target.files[0]; if (!f) return;
    fileUrl = URL.createObjectURL(f);
    const ab = await f.arrayBuffer(); rawData = new DataView(ab);
    const hex = Array.from(new Uint8Array(ab.slice(0,8))).map(b => b.toString(16).padStart(2, '0')).join(' ');
    diag.innerText = `📂 ${f.size}B | HEX: ${hex}`;
};

document.getElementById('p-rec-play').onclick = () => play(recUrl);
document.getElementById('p-file-play').onclick = () => play(fileUrl);

function play(url) {
    if (!url) return;
    if (aCtx.state === 'suspended') aCtx.resume();
    if (activeA) { activeA.pause(); activeA.src = ""; }
    activeA = new Audio(url);
    const aSrc = aCtx.createMediaElementSource(activeA);
    aSrc.connect(anal); anal.connect(aCtx.destination);
    activeA.play();
    activeA.onended = () => { aSrc.disconnect(); };
}

bGlitch.onclick = async () => {
    if (aCtx.state === 'suspended') aCtx.resume();
    let d = rawData;
    if (!d && recUrl) { const res = await fetch(recUrl); const ab = await res.arrayBuffer(); d = new DataView(ab); }
    if (!d) return;
    diag.innerText = "💥 GLITCH (HARDENED)";
    const len = 44100 * 1.5; const buf = aCtx.createBuffer(1, len, 44100); const dat = buf.getChannelData(0);
    const off = Math.floor(Math.random() * (d.byteLength - len * 4));
    for (let i = 0; i < len; i++) { 
        try { 
            let val = d.getFloat32(off + i * 4);
            dat[i] = Math.tanh(val || 0); // Limiter prevents speaker pops
        } catch(e) { dat[i] = 0; } 
    }
    const s = aCtx.createBufferSource(); s.buffer = buf; s.connect(aCtx.destination); s.start();
};

function draw() {
    requestAnimationFrame(draw); if (!anal) return;
    cvs.width = window.innerWidth; cvs.height = window.innerHeight;
    const d = new Uint8Array(anal.frequencyBinCount); anal.getByteTimeDomainData(d);
    ctx.clearRect(0, 0, cvs.width, cvs.height); ctx.lineWidth = 4; ctx.strokeStyle = isF ? "#0ff" : "#9d00ff";
    if (!(isR || (activeA && !activeA.paused))) return;
    ctx.beginPath(); const sw = cvs.width / d.length; let x = 0;
    for (let i = 0; i < d.length; i++) {
        const y = (d[i] / 128.0) * cvs.height / 2;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); x += sw;
    }
    ctx.stroke();
}

function slide(e, s) {
    if (isL || (e.buttons !== 1 && !e.touches)) return;
    const r = e.currentTarget.getBoundingClientRect(); const y = e.touches ? e.touches[0].clientY : e.clientY;
    let v = 1 - (y - r.top) / r.height; ints[s] = Math.max(0, Math.min(1.5, v * 1.5));
    document.getElementById(s + '-f').style.height = (ints[s] / 1.5) * 100 + "%";
    if (ints.l > 1.0 || ints.r > 1.0) { document.body.classList.add('fae'); isF = true; } else { document.body.classList.remove('fae'); isF = false; }
}
function toggleLock() { isL = !isL; document.getElementById('p-lock').innerText = isL ? "LOCK: ON" : "LOCK: OFF"; }
</script>
</body>
</html>

