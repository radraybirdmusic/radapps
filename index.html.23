<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>TRUMPET GARDEN v1.84</title>
    <style>
        :root { --p: #9d00ff; --o: #FF4500; --g: #0f0; --y: #ffcc00; --gry: #888; }
        body { margin: 0; background: #000; color: #fff; font-family: 'Courier New', monospace; overflow: hidden; touch-action: none; }
        .fae { filter: invert(1) hue-rotate(180deg); background: #fff !important; }
        #gate { position: fixed; inset: 0; background: #000; z-index: 1000; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        #ui { position: absolute; inset: 0; z-index: 100; display: none; background: #000; }
        #header { width: 100%; height: 110px; background: rgba(20,20,20,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; border-bottom: 2px solid #333; position: relative; }
        #rec-progress { position: absolute; bottom: 0; left: 0; height: 4px; background: var(--g); width: 0%; transition: width 0.1s linear; }
        .h-row { display: flex; align-items: flex-start; justify-content: center; gap: 8px; width: 98%; }
        .col-btn { display: flex; flex-direction: column; gap: 4px; flex: 1; }
        .btn { background: #111; border: 2px solid var(--p); color: #fff; padding: 10px 4px; border-radius: 8px; cursor: pointer; font-weight: bold; font-size: 11px; text-align: center; width: 100%; }
        .stop-btn { font-size: 9px; padding: 4px; border-width: 1px; opacity: 0.8; }
        .b-yel { border-color: var(--y); color: var(--y); }
        .b-gry { border-color: var(--gry); color: var(--gry); }
        #diag { font-size: 9px; color: var(--g); margin-top: 5px; text-transform: uppercase; font-weight: bold; }
        #ctrl { position: absolute; top: 130px; width: 100%; display: flex; justify-content: center; gap: 40px; z-index: 200; }
        .h-btn { width: 85px; height: 85px; border-radius: 50%; background: #111; border: 2px solid #fff; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36px; cursor: pointer; }
        .sld { position: absolute; width: 50px; height: 260px; background: #111; border: 2px solid #555; border-radius: 25px; top: 250px; pointer-events: auto; z-index: 300; }
        #l-s { left: 4%; } #r-s { right: 4%; }
        .fill { width: 100%; position: absolute; bottom: 0; background: linear-gradient(to top, var(--o), #fff); border-radius: 25px; pointer-events: none; }
        .pad-c { position: absolute; bottom: 80px; width: 100%; display: flex; justify-content: center; gap: 40px; pointer-events: none; }
        #osc { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
        .ham { position: absolute; top: 120px; padding: 5px 10px; font-size: 10px; border: 1px solid var(--y); color: var(--y); background: #000; border-radius: 4px; cursor: pointer; z-index: 500; }
    </style>
</head>
<body>
<div id="gate"><button id="b-mic" class="btn" style="font-size: 24px; padding: 25px 50px; width:300px;">IGNITE v1.84</button></div>
<div id="ui">
    <div id="header">
        <div id="rec-progress"></div>
        <div class="h-row">
            <div class="col-btn"><button id="p-rec-play" class="btn b-yel">PLAY 🐝</button><button id="s-rec-stop" class="btn b-yel stop-btn">STOP ■</button></div>
            <button id="p-lock" class="btn" onclick="toggleLock()">LOCK: OFF</button>
            <button id="b-save" class="btn" style="border-color:#44aaff; color:#44aaff;">SAVE 💾</button>
            <button id="b-glitch" class="btn" style="border-color:#ff4444; color:#ff4444;">GLITCH 💥</button>
            <div class="col-btn"><button id="p-file-play" class="btn b-gry">PLAY 📂</button><button id="s-file-stop" class="btn b-gry stop-btn">STOP ■</button></div>
        </div>
        <div id="diag">STATUS: VISUALIZER RE-LINKED</div>
    </div>

    <button class="ham" style="left: 4%;" onpointerdown="hamMomentum(0.94)">HAM L-</button>
    <button class="ham" style="right: 4%;" onpointerdown="hamMomentum(1.06)">HAM R+</button>

    <div id="ctrl">
        <div style="text-align:center;"><button id="b-rec" class="h-btn">🐝</button></div>
        <div style="text-align:center;"><button id="b-file" class="h-btn">📂</button><input type="file" id="f-in" hidden accept="*/*"></div>
    </div>
    
    <div id="l-s" class="sld" onpointerdown="slide(event,'l')" onpointermove="slide(event,'l')"><div id="l-f" class="fill" style="height:50%"></div></div>
    <div id="r-s" class="sld" onpointerdown="slide(event,'r')" onpointermove="slide(event,'r')"><div id="r-f" class="fill" style="height:50%"></div></div>

    <div class="pad-c">
        <svg width="220" height="220" style="pointer-events:auto"><circle cx="40" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/></svg>
        <svg width="220" height="220" style="pointer-events:auto"><circle cx="40" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="40" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="110" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="40" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="110" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/><circle cx="180" cy="180" r="30" fill="none" stroke="#fff" stroke-width="3"/></svg>
    </div>
</div>
<canvas id="osc"></canvas>
<script>
let aCtx, anal, src, rec, chks = [], virtualCache = null, isL = false, isF = false, ints = {l:0.5, r:0.5}, isR = false, activeA = null, activeSources = [];
let currentArpPitch = 1.0;
const cvs = document.getElementById('osc'), ctx = cvs.getContext('2d'), diag = document.getElementById('diag'), prog = document.getElementById('rec-progress');
const bMic = document.getElementById('b-mic'), bRec = document.getElementById('b-rec'), bFile = document.getElementById('b-file'), fIn = document.getElementById('f-in');

bMic.onclick = async () => {
    document.getElementById('gate').style.display = 'none'; document.getElementById('ui').style.display = 'block';
    try {
        aCtx = new (window.AudioContext || window.webkitAudioContext)();
        const s = await navigator.mediaDevices.getUserMedia({ audio: true });
        src = aCtx.createMediaStreamSource(s); anal = aCtx.createAnalyser(); anal.fftSize = 2048; 
    } catch (err) { diag.innerText = "MIC ERROR"; }
};

bRec.onclick = () => {
    if (rec && rec.state === "recording") return;
    chks = []; isR = true;
    rec = new MediaRecorder(src.mediaStream);
    rec.ondataavailable = e => chks.push(e.data);
    rec.onstop = async () => {
        const blob = new Blob(chks, { type: 'audio/webm' });
        const reader = new FileReader();
        reader.onloadend = () => { virtualCache = reader.result; diag.innerText = `🐝 CACHED: ${virtualCache.length} CHR`; };
        reader.readAsDataURL(blob);
        isR = false; currentArpPitch = 1.0;
    };
    rec.start();
    let startTime = Date.now();
    let interval = setInterval(() => {
        let elapsed = Date.now() - startTime;
        prog.style.width = Math.min((elapsed / 3500) * 100, 100) + '%';
        if (elapsed >= 3500) { clearInterval(interval); if(rec.state==="recording") rec.stop(); }
    }, 50);
};

async function hamMomentum(multiplier) {
    if (!virtualCache) return;
    if (aCtx.state === 'suspended') await aCtx.resume();
    currentArpPitch *= multiplier;
    if (currentArpPitch > 10.0) currentArpPitch = 10.0;
    if (currentArpPitch < 0.1) currentArpPitch = 0.1;
    const res = await fetch(virtualCache);
    const ab = await res.arrayBuffer();
    aCtx.decodeAudioData(ab, (buffer) => {
        let startOffset = 0; const data = buffer.getChannelData(0);
        for(let i=0; i<data.length; i++) { if(Math.abs(data[i]) > 0.01) { startOffset = i / buffer.sampleRate; break; } }
        const s = aCtx.createBufferSource(); s.buffer = buffer; s.playbackRate.value = currentArpPitch;
        s.connect(anal); anal.connect(aCtx.destination); s.start(0, startOffset);
        activeSources.push(s); diag.innerText = `ARP: ${currentArpPitch.toFixed(2)}x`;
        draw();
    });
}

document.getElementById('p-rec-play').onclick = () => { currentArpPitch = 1.0; hamMomentum(1.0); };
document.getElementById('s-rec-stop').onclick = () => stop();
function stop() { activeSources.forEach(s => { try{s.stop()}catch(e){} }); activeSources = []; diag.innerText = "STOPPED"; }
function toggleLock() { isL = !isL; document.getElementById('p-lock').innerText = isL ? "LOCK: ON" : "LOCK: OFF"; }

function slide(e, s) {
    if (isL || (e.buttons !== 1 && !e.touches)) return;
    const r = e.currentTarget.getBoundingClientRect(); const y = e.touches ? e.touches[0].clientY : e.clientY;
    let v = 1 - (y - r.top) / r.height; ints[s] = Math.max(0, Math.min(1.5, v * 1.5));
    document.getElementById(s + '-f').style.height = (ints[s] / 1.5) * 100 + "%";
    
    // THE CRITICAL CHECK: Update isF immediately
    if (ints.l > 1.0 || ints.r > 1.0) { document.body.classList.add('fae'); isF = true; } 
    else { document.body.classList.remove('fae'); isF = false; }
}

function draw() {
    requestAnimationFrame(draw); if (!anal) return;
    cvs.width = window.innerWidth; cvs.height = window.innerHeight;
    const d = new Uint8Array(anal.frequencyBinCount); anal.getByteTimeDomainData(d);
    ctx.clearRect(0, 0, cvs.width, cvs.height); ctx.lineWidth = 4; 
    
    // RE-LINKED: Stroke always respects the current isF state
    ctx.strokeStyle = isF ? "#000000" : "#9d00ff"; 
    
    ctx.beginPath(); const sw = cvs.width / d.length; let x = 0;
    for (let i = 0; i < d.length; i++) {
        const y = (d[i] / 128.0) * cvs.height / 2;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); x += sw;
    }
    ctx.stroke();
}
</script>
</body>
</html>
