<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BANSHEE v2.33.1 - HUMAN SCALE</title>
    <style>
        :root { --p: #9d00ff; --cyan: #00FFFF; --o: #FF4500; }
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; color: #fff; font-family: 'Courier New', monospace; overflow: hidden; }
        
        #gate { position: absolute; inset: 0; z-index: 2000; background: #000; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 4px solid var(--p); box-sizing: border-box; }
        #ui { position: absolute; inset: 0; z-index: 100; display: none; flex-direction: column; }

        /* THE FIX: Fixed heights for headers to prevent button-bloat */
        #header { width: 100%; height: 100px; background: #111; border-bottom: 2px solid #333; flex-shrink: 0; }
        .nav-container { display: flex; align-items: center; justify-content: space-around; height: 100%; }
        
        .btn { background: #222; border: 2px solid var(--p); color: #fff; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px; padding: 10px 20px; }
        
        .stage-area { flex-grow: 1; position: relative; width: 100%; display: flex; justify-content: center; align-items: center; }
        .pad-grid { width: 40%; height: auto; max-height: 250px; }
        
        #canvas-wrap { position: absolute; inset: 0; z-index: 10; pointer-events: none; }
    </style>
</head>
<body>

<div id="gate">
    <h1 style="color:var(--cyan); font-size: 28px;">BANSHEE</h1>
    <button id="b-ignite" class="btn" style="border-color:var(--cyan); font-size: 20px; padding: 30px 60px;">IGNITE</button>
</div>

<div id="ui">
    <div id="header">
        <div class="nav-container">
            <button class="btn" onclick="document.getElementById('f-in').click()">📂 LOAD</button>
            <button id="b-stop" class="btn" style="border-color:red;">■ STOP</button>
            <button class="btn" onclick="document.body.classList.toggle('fae')">✨ FAE</button>
        </div>
        <input type="file" id="f-in" hidden accept="*/*">
    </div>

    <div class="stage-area">
        <svg class="pad-grid" viewBox="0 0 220 230">
            <circle cx="110" cy="110" r="70" stroke="#fff" stroke-width="3" fill="none" onpointerdown="pulse(1.0)" />
            <text x="110" y="115" fill="#fff" text-anchor="middle">ROOT</text>
        </svg>
        <svg class="pad-grid" viewBox="0 0 220 230">
            <rect x="40" y="40" width="140" height="140" stroke="var(--cyan)" stroke-width="3" fill="none" onpointerdown="pulse(2.0)" />
            <text x="110" y="115" fill="var(--cyan)" text-anchor="middle">BITE</text>
        </svg>
    </div>

    <div id="canvas-wrap"><canvas id="main-cvs"></canvas></div>
</div>

<script>
let aCtx, anal, virtualCache = null, activeSources = [];
const cvs = document.getElementById('main-cvs'), ctx = cvs.getContext('2d');

document.getElementById('b-ignite').onclick = async () => {
    document.getElementById('gate').style.display = 'none';
    document.getElementById('ui').style.display = 'flex';
    aCtx = new (window.AudioContext || window.webkitAudioContext)();
    anal = aCtx.createAnalyser();
    anal.fftSize = 2048;
    anal.connect(aCtx.destination);
    animate();
};

document.getElementById('f-in').onchange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const r = new FileReader();
    r.onload = (event) => { virtualCache = event.target.result; };
    r.readAsArrayBuffer(file);
};

async function pulse(rate) {
    if (!virtualCache || !aCtx) return;
    if (aCtx.state === 'suspended') await aCtx.resume();
    const bufferClone = virtualCache.slice(0);
    aCtx.decodeAudioData(bufferClone, (buffer) => {
        const s = aCtx.createBufferSource();
        s.buffer = buffer; s.playbackRate.value = rate;
        s.connect(anal); s.start(0);
        activeSources.push(s);
    });
}

document.getElementById('b-stop').onclick = () => {
    activeSources.forEach(s => { try { s.stop(); } catch(e) {} });
    activeSources = [];
};

function animate() {
    cvs.width = window.innerWidth;
    cvs.height = window.innerHeight;
    const data = new Uint8Array(anal.frequencyBinCount);
    anal.getByteTimeDomainData(data);
    ctx.clearRect(0, 0, cvs.width, cvs.height);
    ctx.lineWidth = 2; ctx.strokeStyle = "var(--cyan)";
    ctx.beginPath();
    let x = 0; let sw = cvs.width / data.length;
    for (let i = 0; i < data.length; i++) {
        let y = (data[i] / 128.0) * cvs.height / 2;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        x += sw;
    }
    ctx.stroke();
    requestAnimationFrame(animate);
}
</script>
</body>
</html>

